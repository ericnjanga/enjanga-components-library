{
  "name": "enjanga-components-library",
  "version": "1.0.120",
  "description": "Reusable, accessible navigation components for Enjanga applications.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "style": "dist/navbar.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./navbar.css": "./dist/navbar.css"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:css && tsup",
    "build:css": "mkdir -p dist && sass --no-source-map --style=compressed src/components/Navbar/_Navbar.scss dist/navbar.css",
    "watch": "concurrently \"npm run watch:ts\" \"npm run watch:css\"",
    "watch:ts": "tsup --watch",
    "watch:css": "sass --no-source-map --watch src/components/Navbar/_Navbar.scss dist/navbar.css",
    "type-check": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "clean": "rm -rf dist storybook-static coverage",
    "prepack": "npm run build",
    "release": "npm version patch && npm publish",
    "chromatic": "npm run build-storybook && chromatic --exit-zero-on-changes"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-webpack5": "^8.6.18",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.5.2",
    "@types/react": "19",
    "@types/react-dom": "19",
    "babel-loader": "^10.1.1",
    "chromatic": "^13.3.0",
    "concurrently": "^9.1.2",
    "css-loader": "^7.1.2",
    "jsdom": "^26.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sass": "^1.94.2",
    "sass-loader": "^16.0.5",
    "storybook": "^8.6.18",
    "style-loader": "^4.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ericnjanga/enjanga-components-library.git"
  },
  "bugs": {
    "url": "https://github.com/ericnjanga/enjanga-components-library/issues"
  },
  "homepage": "https://github.com/ericnjanga/enjanga-components-library#readme",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
